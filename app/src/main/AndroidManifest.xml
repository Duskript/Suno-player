<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for Suno API and CDN audio downloads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service support for WorkManager background playlist/audio downloads. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Storage for downloaded audio files (for API < 29, scoped storage used on 29+) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Wake lock for WorkManager background downloads -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SunoLocalApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_launcher"
        android:label="Suno Local"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SunoLocal"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SunoLocal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            v0.1.27 — Android Auto media app declaration. The automotive app
            descriptor (res/xml/automotive_app_desc.xml) advertises the "media"
            use so the car's Android Auto host lists this app in its driver-safe
            media UI, which renders the MediaLibrarySession browse tree (Suno
            Local → Playlists → saved playlists → tracks). No templated Cars App
            Library UI and no AAOS-specific module in this pass.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Foreground Media3 session service keeps playback alive outside Activity focus. -->
        <service
            android:name=".core.player.SunoPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <!--
                    v0.1.27 — MediaLibraryService is Media3's library-session
                    action; android.media.browse.MediaBrowserService keeps
                    legacy MediaBrowserCompat clients (including the phone-side
                    Android Auto app) able to find this service;
                    androidx.media3.session.MediaSessionService is retained so
                    SunoMediaButtonReceiver (Media3 MediaButtonReceiver) keeps
                    resolving this service for headset/lockscreen keys.
                -->
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
            v0.1.17 — exactly one media button receiver so MediaSessionCompat
            stops logging "Couldn't find a unique registered media button
            receiver". SunoMediaButtonReceiver extends Media3's
            MediaButtonReceiver, which resolves SunoPlaybackService (via the
            androidx.media3.session.MediaSessionService action), starts it as a
            foreground service, and the MediaSession maps headset/lockscreen
            play/pause/next/previous/seek key events onto the shared ExoPlayer.
        -->
        <receiver
            android:name=".core.player.SunoMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
            v0.1.28 — home screen playback widget. Classic AppWidgetProvider +
            RemoteViews (no Glance). Widget buttons use explicit app-private
            provider actions against the shared ExoPlayer — no parallel
            playback stack and no second media button receiver. exported=true
            because the launcher/system delivers the APPWIDGET_UPDATE broadcast.
        -->
        <receiver
            android:name=".core.widget.SunoPlaybackWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/suno_playback_widget_info" />
        </receiver>

        <!--
            v0.1.15 — pause playback when a wired/Bluetooth audio route is
            unplugged. ACTION_AUDIO_BECOMING_NOISY is exempt from the Android 8+
            implicit-broadcast manifest restrictions, so a static receiver works
            on minSdk 26. The receiver only pauses an existing player; it never
            creates playback from scratch.
        -->
        <receiver
            android:name=".core.player.AudioNoisyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.AUDIO_BECOMING_NOISY" />
            </intent-filter>
        </receiver>

        <!--
            v0.1.28 PART 2 — best-effort auto-resume when Android delivers a
            wired-headset, Bluetooth, or car audio route-connect broadcast.
            Modern Android may suppress implicit delivery while the app process
            is stopped or background-limited, so this cannot force resume for
            every route connection. Disconnect pause remains handled separately
            by AudioNoisyReceiver above.
        -->
        <receiver
            android:name=".core.player.AudioRouteResumeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.HEADSET_PLUG" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            WorkManager's SystemForegroundService must declare an explicit
            foregroundServiceType for targetSdk 35. Without this merge entry,
            Android throws InvalidForegroundServiceTypeException as soon as a
            background Suno resync tries to call setForeground().
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:node="merge" />
    </application>
</manifest>
