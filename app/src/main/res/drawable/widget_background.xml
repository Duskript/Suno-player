<?xml version="1.0" encoding="utf-8"?>
<!--
    v0.1.26 — dark rounded background for the home screen playback widget.
    Launchers on API 31+ round widget backgrounds themselves; this keeps the
    widget legible and consistent on older launchers too.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#E6161A24" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
